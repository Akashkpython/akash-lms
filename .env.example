# Copy values into backend/.env and frontend/.env as documented in README.md.
# Never commit real secrets.

# Backend
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/akash-lms
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=8080
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=akash-lms
R2_ENDPOINT=
MAX_UPLOAD_BYTES=52428800
RECYCLE_RETENTION_DAYS=30
PRESIGN_EXPIRES_SECONDS=120

# Frontend (Vite only exposes VITE_ variables to the browser)
VITE_API_URL=http://localhost:8080
VITE_BASE_PATH=/
